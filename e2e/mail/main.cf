compatibility_level = 3.10
myhostname = mta.harness.test
mydomain = harness.test
myorigin = harness.test
mydestination =
inet_interfaces = loopback-only
inet_protocols = ipv4
mynetworks = 127.0.0.0/8

smtpd_relay_restrictions = permit_mynetworks, reject
smtpd_recipient_restrictions = check_recipient_access inline:{ discard.harness.test=DISCARD }, permit_mynetworks, reject

virtual_alias_domains =
virtual_alias_maps = regexp:{ {/^system@system\.harness\.test$$/ system@system.harness.test}, {/@system\.harness\.test$$/ system@system.harness.test}, {/./ ana@harness.test} }
virtual_mailbox_domains = static:all
virtual_mailbox_maps = static:ok
virtual_transport = lmtp:inet:127.0.0.1:31024

local_recipient_maps =
alias_maps =
alias_database =

message_size_limit = 104857600
smtputf8_enable = yes
biff = no
maillog_file = /dev/stdout
